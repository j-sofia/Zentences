{
  "name": "zentences",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run test:coverage && npm run build && npm run test:e2e",
    "format": "prettier --write src server scripts tests *.js *.json index.html",
    "format:check": "prettier --check src server scripts tests *.js *.json index.html"
  },
  "dependencies": {
    "@node-rs/jieba": "^2.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pinyin-pro": "^3.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^5.0.3",
    "prettier": "^3.9.9",
    "supertest": "^7.1.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
